{
  "name": "noteeees",
  "displayName": "Noteeees",
  "description": "Simple markdown notes extension",
  "version": "0.12.0",
  "publisher": "HidenobuNagai",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidenobunagai/noteeees.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "noteeees.welcome",
        "title": "%walkthroughs.noteeees.welcome.title%",
        "description": "%walkthroughs.noteeees.welcome.description%",
        "steps": [
          {
            "id": "setupDirectory",
            "title": "%walkthroughs.noteeees.welcome.steps[0].title%",
            "description": "%walkthroughs.noteeees.welcome.steps[0].description%",
            "media": {
              "markdown": "assets/walkthrough-setup.md"
            }
          },
          {
            "id": "firstNote",
            "title": "%walkthroughs.noteeees.welcome.steps[1].title%",
            "description": "%walkthroughs.noteeees.welcome.steps[1].description%",
            "media": {
              "markdown": "assets/walkthrough-note.md"
            }
          },
          {
            "id": "moments",
            "title": "%walkthroughs.noteeees.welcome.steps[2].title%",
            "description": "%walkthroughs.noteeees.welcome.steps[2].description%",
            "media": {
              "markdown": "assets/walkthrough-moments.md"
            }
          },
          {
            "id": "dashboard",
            "title": "%walkthroughs.noteeees.welcome.steps[3].title%",
            "description": "%walkthroughs.noteeees.welcome.steps[3].description%",
            "media": {
              "markdown": "assets/walkthrough-dashboard.md"
            }
          }
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ],
    "commands": [
      {
        "command": "notes.runSetup",
        "title": "%notes.runSetup.title%"
      },
      {
        "command": "notes.refreshSidebar",
        "title": "%notes.refreshSidebar.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "notes.newNote",
        "title": "%notes.newNote.title%"
      },
      {
        "command": "notes.listNotes",
        "title": "%notes.listNotes.title%"
      },
      {
        "command": "notes.focusMoments",
        "title": "%notes.focusMoments.title%"
      },
      {
        "command": "notes.showOpenTasksOverview",
        "title": "%notes.showOpenTasksOverview.title%"
      },
      {
        "command": "notes.searchTags",
        "title": "%notes.searchTags.title%",
        "icon": "$(tag)"
      },
      {
        "command": "notes.toggleTagSort",
        "title": "%notes.toggleTagSort.title%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "notes.pinNote",
        "title": "%notes.pinNote.title%",
        "icon": "$(pin)"
      },
      {
        "command": "notes.unpinNote",
        "title": "%notes.unpinNote.title%",
        "icon": "$(pinned)"
      },
      {
        "command": "notes.movePinnedNoteUp",
        "title": "%notes.movePinnedNoteUp.title%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "notes.movePinnedNoteDown",
        "title": "%notes.movePinnedNoteDown.title%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "notes.openDailyNote",
        "title": "%notes.openDailyNote.title%",
        "category": "Notes",
        "icon": "$(calendar)"
      },
      {
        "command": "notes.archiveMoments",
        "title": "%notes.archiveMoments.title%",
        "icon": "$(archive)"
      },
      {
        "command": "notes.openDashboard",
        "title": "%notes.openDashboard.title%",
        "icon": "$(checklist)"
      },
      {
        "command": "notes.aiExtractTasks",
        "title": "%notes.aiExtractTasks.title%"
      }
    ],
    "keybindings": [
      {
        "command": "notes.newNote",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "notes.focusMoments",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "notes.movePinnedNoteUp",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "view == notesExplorer && viewItem == pinnedNoteFile"
      },
      {
        "command": "notes.movePinnedNoteDown",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "view == notesExplorer && viewItem == pinnedNoteFile"
      },
      {
        "command": "notes.openDailyNote",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "true"
      },
      {
        "command": "notes.openDashboard",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notesMoments",
          "title": "%notesMomentsContainer.title%",
          "icon": "assets/moments-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "notesExplorer",
          "name": "%notesExplorer.name%",
          "icon": "$(notebook)",
          "contextualTitle": "%notesExplorer.contextualTitle%"
        },
        {
          "id": "notesBacklinks",
          "name": "%notesBacklinks.name%",
          "icon": "$(references)",
          "contextualTitle": "%notesBacklinks.contextualTitle%"
        }
      ],
      "notesMoments": [
        {
          "type": "webview",
          "id": "notesMomentsView",
          "name": "%notesMomentsView.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "notes.listNotes",
          "when": "view == notesExplorer",
          "group": "navigation@1"
        },
        {
          "command": "notes.searchTags",
          "when": "view == notesExplorer",
          "group": "navigation@2"
        },
        {
          "command": "notes.toggleTagSort",
          "when": "view == notesExplorer",
          "group": "navigation@3"
        },
        {
          "command": "notes.refreshSidebar",
          "when": "view == notesExplorer",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "notes.pinNote",
          "when": "view == notesExplorer && viewItem == noteFile",
          "group": "inline"
        },
        {
          "command": "notes.unpinNote",
          "when": "view == notesExplorer && viewItem == pinnedNoteFile",
          "group": "inline"
        },
        {
          "command": "notes.movePinnedNoteUp",
          "when": "view == notesExplorer && viewItem == pinnedNoteFile",
          "group": "navigation@1"
        },
        {
          "command": "notes.movePinnedNoteDown",
          "when": "view == notesExplorer && viewItem == pinnedNoteFile",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "notes.notesDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%notes.notesDirectory.description%"
        },
        "notes.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm",
          "enum": [
            "YYYY-MM-DD HH:mm",
            "YYYY-MM-DD",
            "MM/DD/YYYY HH:mm",
            "DD.MM.YYYY HH:mm"
          ],
          "description": "%notes.dateFormat.description%"
        },
        "notes.defaultNoteTitle": {
          "type": "string",
          "default": "{dt}_{title}.{ext}",
          "description": "%notes.defaultNoteTitle.description%"
        },
        "notes.noteTitleConvertSpaces": {
          "type": "string",
          "default": "_",
          "description": "%notes.noteTitleConvertSpaces.description%"
        },
        "notes.defaultSnippet": {
          "type": "object",
          "default": {
            "langId": "markdown",
            "name": "noteeees_template_note"
          },
          "properties": {
            "langId": {
              "type": "string",
              "description": "Language ID for the snippet."
            },
            "name": {
              "type": "string",
              "description": "Snippet name to insert. Set to null to disable."
            }
          },
          "description": "%notes.defaultSnippet.description%"
        },
        "notes.templates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%notes.templates.description%"
        },
        "notes.sidebarRecentLimit": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "%notes.sidebarRecentLimit.description%"
        },
        "notes.sidebarTagSort": {
          "type": "string",
          "default": "frequency",
          "enum": [
            "frequency",
            "alphabetical"
          ],
          "description": "%notes.sidebarTagSort.description%"
        },
        "notes.momentsSubfolder": {
          "type": "string",
          "default": "moments",
          "scope": "machine",
          "description": "%notes.momentsSubfolder.description%"
        },
        "notes.momentsSendOnEnter": {
          "type": "boolean",
          "default": true,
          "description": "%notes.momentsSendOnEnter.description%"
        },
        "notes.momentsFeedDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "description": "%notes.momentsFeedDays.description%"
        },
        "notes.momentsInboxFilter": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "open",
            "done"
          ],
          "description": "%notes.momentsInboxFilter.description%"
        },
        "notes.momentsArchiveAfterDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "description": "%notes.momentsArchiveAfterDays.description%"
        },
        "notes.dailyNoteTemplate": {
          "type": "string",
          "default": "",
          "description": "%notes.dailyNoteTemplate.description%"
        },
        "notes.workspaceNotesDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%notes.workspaceNotesDirectory.description%"
        },
        "notes.ai.autoEnrich": {
          "type": "boolean",
          "default": false,
          "description": "%notes.ai.autoEnrich.description%"
        },
        "notes.statusBarTasks": {
          "type": "boolean",
          "default": true,
          "description": "%notes.statusBarTasks.description%"
        },
        "notes.locale": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "description": "%notes.locale.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js && bun run compile:mcp",
    "watch": "bunx npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production && bun run compile:mcp",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint && bun run test:mcp",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts' 'notes-mcp/src/**/*.ts' 'notes-mcp/test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'notes-mcp/src/**/*.ts' 'notes-mcp/test/**/*.ts'",
    "compile:mcp": "cd notes-mcp && bun run build",
    "test:mcp": "cd notes-mcp && bun test",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
